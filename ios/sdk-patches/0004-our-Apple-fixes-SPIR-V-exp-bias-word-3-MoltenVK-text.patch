From 50a69c5b894aaa9e515abcb8375175266b494ce5 Mon Sep 17 00:00:00 2001
From: blz <blz@local>
Date: Tue, 17 Nov 2026 04:32:28 -0500
Subject: [PATCH 4/7] our Apple fixes: SPIR-V exp bias word 3 (MoltenVK
 textures), iOS stereo fold

---
 src/audio/sdl/sdl_audio_driver.cpp | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/audio/sdl/sdl_audio_driver.cpp b/src/audio/sdl/sdl_audio_driver.cpp
index a6bf1be..02d9572 100644
--- a/src/audio/sdl/sdl_audio_driver.cpp
+++ b/src/audio/sdl/sdl_audio_driver.cpp
@@ -16,6 +16,9 @@
 #include <rex/assert.h>
 #include <rex/audio/conversion.h>
 #include <rex/audio/downmix.h>
+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
 #include <rex/audio/flags.h>
 #include <rex/audio/sdl/sdl_audio_driver.h>
 #include <rex/cvar.h>
@@ -75,7 +78,14 @@ bool SDLAudioDriver::Initialize() {
 
   // A 1-channel device gets the stereo fold too, then SDL collapses to mono.
   // Handing it a 6ch stream instead would use SDL's own downmix.
-  if (obtained_spec.channels <= 2) {
+  // iPhone/iPad: always stereo. SDL reports the 6ch stream it was asked for as the device format there, so the
+  // 5.1 mix went straight to a stereo speaker/AirPods route and sounded wrong (MK vs DC on iPhone 15 Pro Max,
+  // 10 Nov 2026). Our own 6->2 fold (the one the Mac uses on stereo outputs) is used instead.
+  bool force_stereo = false;
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+  force_stereo = true;
+#endif
+  if (force_stereo || obtained_spec.channels <= 2) {
     SDL_DestroyAudioStream(sdl_stream_);
     sdl_stream_ = nullptr;
     desired_spec.channels = 2;
-- 
