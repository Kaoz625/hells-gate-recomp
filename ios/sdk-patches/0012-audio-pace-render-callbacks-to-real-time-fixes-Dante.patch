 include/rex/audio/audio_system.h         |  4 +++
 include/rex/audio/sdl/sdl_audio_driver.h |  4 +++
 src/audio/audio_system.cpp               | 41 ++++++++++++++++++++++++
 src/audio/sdl/sdl_audio_driver.cpp       |  5 ++-
