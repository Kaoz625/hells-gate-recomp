diff --git a/src/audio/audio_system.cpp b/src/audio/audio_system.cpp
index 21c7a94..3256555 100644
--- a/src/audio/audio_system.cpp
+++ b/src/audio/audio_system.cpp
@@ -27,7 +27,13 @@
 #include <rex/system/thread_state.h>
 #include <rex/thread.h>
 #include <rex/cvar.h>
+#include <chrono>
+#include <thread>
 
+REXCVAR_DEFINE_BOOL(
+    audio_pace_callbacks, true, "Audio",
+    "Run each client's render callback at most once per guest audio frame (256 samples = 5.33 ms) of real time "
+    "instead of back to back when the output device frees several frames at once");
 REXCVAR_DEFINE_INT32(
     audio_maxqframes, 32, "Audio",
     "Max buffered audio frames (range 4-64). Lower reduces latency but may cause stuttering.");
@@ -100,6 +106,38 @@ X_STATUS AudioSystem::Setup(system::KernelState* kernel_state) {
   return X_STATUS_SUCCESS;
 }
 
+// The guest's audio engine expects its render callback about every 5.33 ms, as on the console. When the output device
+// pulls several frames at once (CoreAudio on macOS 4 frames per pull, iOS likewise), the worker ran 2-4 callbacks
+// back to back in well under a millisecond, and Dante's Inferno's mixer (XMA voices kicked and refilled between
+// passes) only had new data for every other 512-sample block: the output went 1100 1100... (2 frames sound, 2 silent),
+// heard as harsh distortion that never stops (iPhone 15 Pro Max and M1 Mac, arm64 and x86_64 alike, 17 Nov 2026).
+// Pacing the callbacks to real time keeps the queue a few frames deep and the mix whole.
+void AudioSystem::PaceClientCallback(size_t index, int queued) {
+  if (!REXCVAR_GET(audio_pace_callbacks) || index >= kMaximumClientCount) {
+    return;
+  }
+  using Clock = std::chrono::steady_clock;
+  constexpr auto kFrame = std::chrono::nanoseconds(1000000000ll * 256 / 48000);
+  // Keep about this many frames (43 ms) queued at the device: a real-time pace above it, 10% faster below it.
+  // The queue never reaches audio_maxqframes, so the device's own multi-frame pulls never release a burst.
+  constexpr int kTargetQueued = 8;
+  auto& next_due = client_next_callback_[index];
+  auto now = Clock::now();
+  if (queued >= 0 && queued < kTargetQueued / 2) {
+    // Start-up or after a stall: fill to half the target at once.
+    next_due = now;
+    return;
+  }
+  const auto interval = (queued >= 0 && queued < kTargetQueued) ? kFrame * 9 / 10 : kFrame;
+  if (next_due > now) {
+    std::this_thread::sleep_until(next_due);
+    now = next_due;
+  } else if (now - next_due > kFrame * 4) {
+    next_due = now;
+  }
+  next_due += interval;
+}
+
 void AudioSystem::WorkerThreadMain() {
 #if REX_PLATFORM_MAC || REX_PLATFORM_IOS
   // This thread feeds the output device every few milliseconds and uses little
@@ -146,6 +184,8 @@ void AudioSystem::WorkerThreadMain() {
       auto global_lock = global_critical_region_.Acquire();
       uint32_t client_callback = clients_[index].callback;
       uint32_t client_callback_arg = clients_[index].wrapped_callback_arg;
+      const int client_queued =
+          clients_[index].driver ? clients_[index].driver->queued_frames() : -1;
       global_lock.unlock();
 
       if (client_callback) {
@@ -154,6 +194,7 @@ void AudioSystem::WorkerThreadMain() {
                        client_callback, client_callback_arg, index);
         }
         SCOPE_profile_cpu_i("apu", "rex::audio::AudioSystem->client_callback");
+        PaceClientCallback(index, client_queued);
         uint64_t args[] = {client_callback_arg};
         function_dispatcher_->Execute(worker_thread_->thread_state(), client_callback, args,
                                       rex::countof(args));
