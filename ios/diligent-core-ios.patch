diff --git a/Graphics/GraphicsEngineVulkan/src/VulkanUtilities/Instance.cpp b/Graphics/GraphicsEngineVulkan/src/VulkanUtilities/Instance.cpp
index 4534337..a6542cb 100644
--- a/Graphics/GraphicsEngineVulkan/src/VulkanUtilities/Instance.cpp
+++ b/Graphics/GraphicsEngineVulkan/src/VulkanUtilities/Instance.cpp
@@ -251,12 +251,28 @@ std::shared_ptr<Instance> Instance::Create(const CreateInfo& CI)
 }
 
 #if DILIGENT_USE_VOLK
+#if PLATFORM_IOS
+#    include <dlfcn.h>
+#endif
 static bool LoadVulkan()
 {
     static bool VulkanLoaded = false;
     if (VulkanLoaded)
         return true;
 
+#if PLATFORM_IOS
+    // iOS: MoltenVK ships inside the app (Frameworks/libMoltenVK.dylib); volk's own search (libvulkan.dylib, a
+    // bare libMoltenVK.dylib) does not look there. Load that copy - the one the rest of the app uses.
+    if (void* Lib = dlopen("@executable_path/Frameworks/libMoltenVK.dylib", RTLD_NOW | RTLD_LOCAL))
+    {
+        if (auto GetInstanceProcAddr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(Lib, "vkGetInstanceProcAddr")))
+        {
+            volkInitializeCustom(GetInstanceProcAddr);
+            VulkanLoaded = true;
+            return true;
+        }
+    }
+#endif
     VulkanLoaded = (volkInitialize() == VK_SUCCESS);
     return VulkanLoaded;
 }
